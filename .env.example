# Copy this file to .env for local development (never commit real secrets)

# PostgreSQL settings
POSTGRES_USER=lifeguard
POSTGRES_PASSWORD=lifeguard_pass
POSTGRES_DB=lifeguard_db

# Backend database URL (use localhost when running backend outside Docker, 'db' inside Docker)
DATABASE_URL=postgresql://lifeguard:lifeguard_pass@localhost:5432/lifeguard_db

# JWT settings (use a long random string in production, >= 32 characters)
SECRET_KEY=dev-only-change-this-to-a-long-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
