# LifeGuard AI — Environment Configuration Template
# Copy this file to .env for local development (never commit real production secrets)

# Application & Database Settings
DATABASE_URL=postgresql://lifeguard:lifeguard_pass@localhost:5432/lifeguard_db
POSTGRES_USER=lifeguard
POSTGRES_PASSWORD=lifeguard_pass
POSTGRES_DB=lifeguard_db

# JWT Session Configuration (>= 32 random characters in production)
SECRET_KEY=dev-only-change-this-to-a-long-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
COOKIE_SECURE=false

# Google OAuth 2.0 Client (Google Identity Services)
GOOGLE_CLIENT_ID=981860772372-uvhn6fnfkfhpfskar3bk1i7de4fsp3b9.apps.googleusercontent.com

# GitHub OAuth 2.0 Application Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Frontend Client Environment
VITE_GOOGLE_CLIENT_ID=981860772372-uvhn6fnfkfhpfskar3bk1i7de4fsp3b9.apps.googleusercontent.com
